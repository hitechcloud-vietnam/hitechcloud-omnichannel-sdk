{
    "name": "hitechcloud-vietnam/omnichannel-sdk",
    "description": "SDK PHP chính thức cho HiTechCloud Omnichannel API (hội thoại đa kênh)",
    "type": "library",
    "license": "MIT",
    "keywords": ["hitechcloud", "omnichannel", "facebook", "zalo", "tiktok", "instagram", "chat", "sdk"],
    "homepage": "https://developers.hitechcloud.vn",
    "authors": [
        {
            "name": "HiTechCloud Vietnam",
            "email": "support@hitechcloud.vn"
        }
    ],
    "require": {
        "php": ">=8.0",
        "guzzlehttp/guzzle": "^7.0",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "HiTechCloud\\Omnichannel\\": "src/"
        },
        "files": [
            "src/Exceptions.php",
            "src/Resources/Misc.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "HiTechCloud\\Omnichannel\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable"
}
